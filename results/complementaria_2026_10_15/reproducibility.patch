+++ b/tests/unit/test_portable_verification.py
@@ -0,0 +1,210 @@
+"""Portability never grants permission to change money, identities or categories."""
+
+import importlib.util
+
+import pytest
+
+
+def api():
+    assert importlib.util.find_spec("scripts.compact_numeric_policy"), "portable comparison absent"
+    from scripts import compact_numeric_policy
+
+    return compact_numeric_policy
+
+
+def test_accepts_last_digit_cagr_without_changing_source_rows():
+    actual = [{"run_id": "r", "cagr": "0.0522270351463172"}]
+    api().same_rows(actual, [{"run_id": "r", "cagr": 0.05222703514631721}], "metrics")
+    assert actual[0]["cagr"] == "0.0522270351463172"
+
+
+@pytest.mark.parametrize(
+    "key,a,b",
+    [
