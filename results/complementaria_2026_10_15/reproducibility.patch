+def test_preflight_rejects_changed_code_before_loading_it(tmp_path):
+    import hashlib
+    import json
+
+    code = tmp_path / "verifier.py"
+    code.write_bytes(b'print("original")\n')
+    manifest = tmp_path / "manifiesto_paquete.json"
+    manifest.write_text(
+        json.dumps(
+            {
+                "members": [
+                    dict(
+                        path="verifier.py",
+                        bytes=code.stat().st_size,
+                        sha256=hashlib.sha256(code.read_bytes()).hexdigest(),
+                    )
+                ]
+            }
+        )
+    )
+    pinned = hashlib.sha256(manifest.read_bytes()).hexdigest()
+    (tmp_path / "manifiesto_paquete.sha256").write_text(pinned + "\n")
+    assert hasattr(api(), "authenticate_package"), "trusted preflight absent"
+    assert api().authenticate_package(tmp_path, pinned)["members"] == 1
+    code.write_bytes(b'print("tampered")\n')
+    with pytest.raises(ValueError, match="member"):
+        api().authenticate_package(tmp_path, pinned)
+
+
+def test_preflight_rejects_self_consistent_reseal_and_unlisted_member(tmp_path):
+    import hashlib
+    import json
+
+    manifest = tmp_path / "manifiesto_paquete.json"
+    manifest.write_text(json.dumps({"members": []}))
+    pinned = hashlib.sha256(manifest.read_bytes()).hexdigest()
+    (tmp_path / "manifiesto_paquete.sha256").write_text(pinned + "\n")
+    assert hasattr(api(), "authenticate_package"), "trusted preflight absent"
+    (tmp_path / "extra").write_text("added")
+    with pytest.raises(ValueError, match="membership"):
+        api().authenticate_package(tmp_path, pinned)
+    manifest.write_text(json.dumps({"members": [], "new": "resealed"}))
+    (tmp_path / "manifiesto_paquete.sha256").write_text(
+        hashlib.sha256(manifest.read_bytes()).hexdigest()
+    )
+    with pytest.raises(ValueError, match="pinned"):
+        api().authenticate_package(tmp_path, pinned)
+
